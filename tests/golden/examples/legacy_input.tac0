== tac ==
    counter = 5
    total = 0.0
    ifz counter goto L0
    $t0 = total + 10.5
    total = $t0
    goto L1
L0:
    $t1 = total - 1.0
    total = $t1
L1:
L2:
    ifz counter goto L3
    $t2 = counter * 2
    $t3 = float($t2)
    $t4 = total + $t3
    total = $t4
    $t5 = counter - 1
    counter = $t5
    goto L2
L3:
    print total
--- stderr ---
--- exit: 0 ---
