== tac ==
    n = 27
    steps = 0
L0:
    $t0 = n != 1
    ifz $t0 goto L1
    $t1 = n % 2
    $t2 = $t1 == 0
    ifz $t2 goto L2
    $t3 = n / 2
    n = $t3
    goto L3
L2:
    $t4 = 3 * n
    $t5 = $t4 + 1
    n = $t5
L3:
    $t6 = steps + 1
    steps = $t6
    goto L0
L1:
    print steps
--- stderr ---
--- exit: 0 ---
