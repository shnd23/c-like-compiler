== tac ==
    guess = 1.0
    round = 0
L0:
    $t0 = round < 6
    ifz $t0 goto L1
    $t1 = float(2)
    $t2 = $t1 / guess
    $t3 = guess + $t2
    $t4 = float(2)
    $t5 = $t3 / $t4
    guess = $t5
    $t6 = round + 1
    round = $t6
    goto L0
L1:
    print guess
    total = 17
    count = 4
    $t7 = total / count
    $t8 = float($t7)
    average = $t8
    print average
    $t9 = float(total)
    $t10 = $t9 / 4.0
    average = $t10
    print average
    $t11 = -average
    print $t11
    $t12 = 1.0 / 3.0
    print $t12
--- stderr ---
--- exit: 0 ---
