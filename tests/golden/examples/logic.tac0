== tac ==
    d = 0
    $t1 = d != 0
    ifz $t1 goto L0
    $t2 = 10 / d
    $t3 = $t2 > 1
    ifz $t3 goto L0
    $t0 = 1
    goto L1
L0:
    $t0 = 0
L1:
    ifz $t0 goto L2
    print 1
    goto L3
L2:
    print 0
L3:
    $t5 = d == 0
    ifnz $t5 goto L4
    $t6 = 10 / d
    $t7 = $t6 > 1
    ifnz $t7 goto L4
    $t4 = 0
    goto L5
L4:
    $t4 = 1
L5:
    ifz $t4 goto L6
    print 2
L6:
    $t8 = !d
    print $t8
    $t9 = !5
    print $t9
    $t11 = 3 < 4
    ifz $t11 goto L7
    $t12 = 4 < 5
    ifz $t12 goto L7
    $t10 = 1
    goto L8
L7:
    $t10 = 0
L8:
    print $t10
    $t13 = float(1)
    $t14 = $t13 == 1.0
    print $t14
    $t16 = 2 >= 3
    ifnz $t16 goto L9
    ifnz 0 goto L9
    $t15 = 0
    goto L10
L9:
    $t15 = 1
L10:
    print $t15
--- stderr ---
--- exit: 0 ---
